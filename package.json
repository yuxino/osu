{
  "name": "osu",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "ios:device": "expo run:ios --device --configuration Release",
    "ios:configure": "bundle exec ruby scripts/configure-ios-prototype.rb",
    "ios:prebuild": "expo prebuild --platform ios --no-install --no-clean"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
